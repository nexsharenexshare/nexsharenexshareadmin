<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexShare Global - Advanced Master Admin Portal</title>

    <!-- Tailwind CSS & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Firebase SDK (v9 Compat) -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>

    <style>
        body {
            background-color: #050814;
            color: #f8fafc;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .gold-gradient-text {
            background: linear-gradient(135deg, #fff3a8 0%, #d4af37 50%, #aa7c11 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .gold-gradient-bg {
            background: linear-gradient(135deg, #fce055 0%, #d4af37 50%, #9e740e 100%);
            color: #050814;
        }
        .card-glass {
            background: rgba(13, 21, 39, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.25);
        }
    </style>
</head>
<body class="min-h-screen p-4 md:p-8 flex justify-center items-start">

    <div class="w-full max-w-6xl space-y-6">

        <!-- Admin Header -->
        <header class="card-glass p-5 rounded-2xl flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl gold-gradient-bg flex items-center justify-center font-bold text-xl text-slate-950 shadow-lg shadow-amber-500/20">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <h1 class="font-cinzel text-xl font-bold gold-gradient-text">NEXSHARE ADVANCED ADMIN</h1>
                    <p class="text-xs text-slate-400">সম্পূর্ণ সিস্টেম ইউজার ম্যানেজমেন্ট ও লাইভ ট্র্যাকিং</p>
                </div>
            </div>
            <div id="authStatus" class="text-xs bg-amber-500/10 border border-amber-500/30 px-3 py-1.5 rounded-lg text-amber-300 font-semibold">
                🔒 সিকিউর্ড মাস্টার প্যানেল
            </div>
        </header>

        <!-- Login Card -->
        <div id="adminAuthCard" class="card-glass p-6 rounded-2xl max-w-md mx-auto space-y-4">
            <h2 class="text-center font-bold text-base text-amber-300 border-b border-slate-800 pb-2">অ্যাডমিন অ্যাক্সেস যাচাই</h2>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs text-slate-300 mb-1">সিক্রেট এডমিন পাসওয়ার্ড</label>
                    <input type="password" id="adminPassInput" placeholder="পাসওয়ার্ড লিখুন" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-xl text-xs text-slate-100 outline-none focus:border-amber-500">
                </div>
                <button onclick="verifyAdminPass()" class="w-full gold-gradient-bg py-2.5 rounded-xl font-bold text-xs shadow-lg shadow-amber-500/20">
                    লগইন করুন
                </button>
            </div>
        </div>

        <!-- Main Admin Dashboard -->
        <main id="adminMainContent" class="hidden space-y-6">

            <!-- Live Analytics Counters -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="card-glass p-4 rounded-xl text-center space-y-1">
                    <span class="text-xs text-slate-400 block">এক্টিভ ইউজার</span>
                    <span id="cntActiveUsers" class="text-2xl font-black text-emerald-400">0</span>
                </div>
                <div class="card-glass p-4 rounded-xl text-center space-y-1">
                    <span class="text-xs text-slate-400 block">মোট রেফারেল</span>
                    <span id="cntTotalRefs" class="text-2xl font-black text-amber-400">0</span>
                </div>
                <div class="card-glass p-4 rounded-xl text-center space-y-1">
                    <span class="text-xs text-slate-400 block">মোট সফল ডিপোজিট</span>
                    <span id="cntTotalDp" class="text-2xl font-black text-sky-400">৳0</span>
                </div>
                <div class="card-glass p-4 rounded-xl text-center space-y-1">
                    <span class="text-xs text-slate-400 block">মোট সফল উইথড্র</span>
                    <span id="cntTotalWd" class="text-2xl font-black text-rose-400">৳0</span>
                </div>
            </div>

            <!-- Navigation Tabs -->
            <div class="flex flex-wrap gap-2 border-b border-slate-800 pb-3">
                <button onclick="switchTab('users')" id="tab-users" class="px-4 py-2 text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-xl">ইউজার ম্যানেজমেন্ট</button>
                <button onclick="switchTab('dep')" id="tab-dep" class="px-4 py-2 text-xs font-bold text-slate-400 rounded-xl">পেন্ডিং ডিপোজিট</button>
                <button onclick="switchTab('wd')" id="tab-wd" class="px-4 py-2 text-xs font-bold text-slate-400 rounded-xl">পেন্ডিং উইথড্র</button>
                <button onclick="switchTab('txlog')" id="tab-txlog" class="px-4 py-2 text-xs font-bold text-slate-400 rounded-xl">ট্রানজেকশন লগ</button>
                <button onclick="switchTab('plans')" id="tab-plans" class="px-4 py-2 text-xs font-bold text-slate-400 rounded-xl">প্যাকেজ কন্ট্রোল</button>
                <button onclick="switchTab('gift')" id="tab-gift" class="px-4 py-2 text-xs font-bold text-slate-400 rounded-xl">গিফট কোড</button>
                <button onclick="switchTab('settings')" id="tab-settings" class="px-4 py-2 text-xs font-bold text-slate-400 rounded-xl">সিকিউরিটি ও সেটিংস</button>
            </div>

            <!-- 1. User Management -->
            <section id="sectionUsers" class="card-glass p-5 rounded-2xl space-y-4">
                <h3 class="font-bold text-sm text-amber-300 flex items-center gap-2">
                    <i class="fa-solid fa-users-gear"></i> ইউজার সার্চ, ব্যালেন্স এডিট ও ব্লক/আনব্লক
                </h3>
                
                <div class="flex gap-2">
                    <input type="text" id="userSearchInput" placeholder="ইউজার মোবাইল নম্বর দিয়ে সার্চ করুন (যেমন: 017xxxxxxxx)" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-xl text-xs text-slate-100 outline-none focus:border-amber-500">
                    <button onclick="searchUser()" class="gold-gradient-bg px-5 py-2.5 rounded-xl font-bold text-xs shrink-0">
                        খুঁজুন
                    </button>
                </div>

                <div id="userSearchResult" class="hidden bg-slate-950 p-4 rounded-xl border border-amber-500/30 space-y-4"></div>
            </section>

            <!-- 2. Pending Deposits Section -->
            <section id="sectionDep" class="hidden card-glass p-5 rounded-2xl space-y-4">
                <h3 class="font-bold text-sm text-amber-300 flex items-center gap-2">
                    <i class="fa-solid fa-wallet"></i> পেন্ডিং ডিপোজিট আবেদন
                </h3>
                <div id="depListContainer" class="space-y-3 max-h-96 overflow-y-auto"></div>
            </section>

            <!-- 3. Pending Withdrawals Section -->
            <section id="sectionWd" class="hidden card-glass p-5 rounded-2xl space-y-4">
                <h3 class="font-bold text-sm text-amber-300 flex items-center gap-2">
                    <i class="fa-solid fa-hand-holding-dollar"></i> পেন্ডিং উইথড্র রিকোয়েস্ট
                </h3>
                <div id="wdListContainer" class="space-y-3 max-h-96 overflow-y-auto"></div>
            </section>

            <!-- 4. Complete Transaction History Log -->
            <section id="sectionTxlog" class="hidden card-glass p-5 rounded-2xl space-y-4">
                <h3 class="font-bold text-sm text-amber-300 flex items-center gap-2">
                    <i class="fa-solid fa-list-check"></i> প্ল্যাটফর্মের সমস্ত ট্রানজেকশন লগ
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-900 text-amber-300 uppercase text-[10px]">
                            <tr>
                                <th class="p-2.5">ইউজার</th>
                                <th class="p-2.5">টাইপ</th>
                                <th class="p-2.5">পরিমাণ</th>
                                <th class="p-2.5">বিবরণ</th>
                                <th class="p-2.5">স্ট্যাটাস</th>
                            </tr>
                        </thead>
                        <tbody id="txLogTableBody" class="divide-y divide-slate-800"></tbody>
                    </table>
                </div>
            </section>

            <!-- 5. Investment Plans Management Section -->
            <section id="sectionPlans" class="hidden card-glass p-5 rounded-2xl space-y-5">
                <div class="bg-slate-950/80 p-4 rounded-xl border border-amber-500/30 space-y-3">
                    <h4 id="planFormTitle" class="font-bold text-xs text-amber-300">নতুন ইনভেস্টমেন্ট প্যাকেজ যোগ করুন</h4>
                    <input type="hidden" id="planEditKey" value="">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">প্যাকেজের নাম</label>
                            <input type="text" id="planName" placeholder="যেমন: Premium Share" class="w-full bg-slate-900 border border-slate-700 p-2 rounded text-xs text-slate-100 outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">মূল্য (৳)</label>
                            <input type="number" id="planPrice" placeholder="500" class="w-full bg-slate-900 border border-slate-700 p-2 rounded text-xs text-slate-100 outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">দৈনিক লাভ (৳)</label>
                            <input type="number" id="planDaily" placeholder="40" class="w-full bg-slate-900 border border-slate-700 p-2 rounded text-xs text-slate-100 outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">মেয়াদ (দিন)</label>
                            <input type="number" id="planValidity" placeholder="30" class="w-full bg-slate-900 border border-slate-700 p-2 rounded text-xs text-slate-100 outline-none">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">মোবাইল থেকে ছবি সিলেক্ট করুন</label>
                            <input type="file" id="planImageFile" accept="image/*" class="w-full bg-slate-900 border border-slate-700 p-1.5 rounded text-xs text-slate-300 outline-none file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-[10px] file:font-bold file:bg-amber-500 file:text-slate-950">
                        </div>
                        <div>
                            <label class="block text-[11px] text-slate-400 mb-1">অথবা ছবির সরাসরি URL</label>
                            <input type="url" id="planImgUrl" placeholder="https://..." class="w-full bg-slate-900 border border-slate-700 p-2 rounded text-xs text-slate-100 outline-none">
                        </div>
                    </div>
                    
                    <div class="flex gap-2 pt-2">
                        <button onclick="savePlan()" id="planSubmitBtn" class="gold-gradient-bg px-5 py-2 rounded-lg font-bold text-xs shadow-md">
                            প্যাকেজ সেভ করুন
                        </button>
                        <button onclick="resetPlanForm()" id="planCancelBtn" class="hidden bg-slate-800 text-slate-300 px-4 py-2 rounded-lg font-bold text-xs">
                            বাতিল করুন
                        </button>
                    </div>
                </div>

                <div class="space-y-2">
                    <h4 class="font-bold text-xs text-slate-300">বর্তমান লাইভ প্যাকেজসমূহ (এডিট ও ডিলিট সুবিধা):</h4>
                    <div id="plansListContainer" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
                </div>
            </section>

            <!-- 6. Gift Code Section -->
            <section id="sectionGift" class="hidden card-glass p-5 rounded-2xl space-y-5">
                <div class="bg-slate-950/80 p-4 rounded-xl border border-amber-500/30 space-y-3">
                    <h4 class="font-bold text-xs text-amber-300">নতুন গিফট কোড তৈরি করুন</h4>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <input type="text" id="giftCodeInput" placeholder="কোড (যেমন: NEX50)" class="bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-xs uppercase outline-none">
                        <input type="number" id="giftAmountInput" placeholder="টাকার পরিমাণ (৳)" class="bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-xs outline-none">
                        <button onclick="createGiftCode()" class="gold-gradient-bg py-2.5 rounded-lg font-bold text-xs shadow-md">
                            কোড পাবলিশ করুন
                        </button>
                    </div>
                </div>

                <div id="giftListContainer" class="space-y-2 max-h-60 overflow-y-auto"></div>
            </section>

            <!-- 7. Security & Admin Settings (Includes Customer Service Links) -->
            <section id="sectionSettings" class="hidden card-glass p-5 rounded-2xl space-y-5 max-w-xl">
                <div class="space-y-3 border-b border-slate-800 pb-4">
                    <h3 class="font-bold text-sm text-amber-300 flex items-center gap-2">
                        <i class="fa-solid fa-key"></i> অ্যাডমিন পাসওয়ার্ড পরিবর্তন করুন
                    </h3>
                    <input type="password" id="newAdminPassInput" placeholder="নতুন পাসওয়ার্ড লিখুন" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-xs text-slate-100 outline-none">
                    <button onclick="changeAdminPassword()" class="w-full gold-gradient-bg py-2 rounded-lg font-bold text-xs">
                        পাসওয়ার্ড আপডেট করুন
                    </button>
                </div>

                <div class="space-y-3">
                    <h3 class="font-bold text-sm text-amber-300 flex items-center gap-2">
                        <i class="fa-solid fa-gear"></i> পেমেন্ট নম্বর, নোটিশ ও কাস্টমার সার্ভিস সেটিংস
                    </h3>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs text-pink-400 font-semibold mb-1">bKash Personal Number</label>
                            <input type="text" id="settingBkashNum" placeholder="017xxxxxxxx" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-amber-300 font-mono outline-none">
                        </div>
                        <div>
                            <label class="block text-xs text-orange-400 font-semibold mb-1">Nagad Personal Number</label>
                            <input type="text" id="settingNagadNum" placeholder="018xxxxxxxx" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-amber-300 font-mono outline-none">
                        </div>
                    </div>

                    <div class="space-y-2 border-t border-slate-800/80 pt-3">
                        <label class="block text-xs text-sky-400 font-bold flex items-center gap-1.5">
                            <i class="fa-brands fa-telegram"></i> টেলিগ্রাম কাস্টমার সার্ভিস লিংক
                        </label>
                        <input type="url" id="settingTelegramLink" placeholder="https://t.me/your_username_or_group" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-xs text-slate-100 outline-none">
                    </div>

                    <div class="space-y-2">
                        <label class="block text-xs text-emerald-400 font-bold flex items-center gap-1.5">
                            <i class="fa-brands fa-whatsapp"></i> হোয়াটসঅ্যাপ সাপোর্ট লিংক (অথবা নম্বর)
                        </label>
                        <input type="url" id="settingWhatsappLink" placeholder="https://wa.me/8801700000000" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-xs text-slate-100 outline-none">
                    </div>

                    <div class="border-t border-slate-800/80 pt-3">
                        <label class="block text-xs text-slate-300 mb-1">হেডার স্ক্রোল নোটিশ</label>
                        <textarea id="settingNotice" rows="2" class="w-full bg-slate-900 border border-slate-700 p-2.5 rounded-lg text-slate-100 outline-none" placeholder="নোটিশ টাইপ করুন..."></textarea>
                    </div>

                    <button onclick="saveSettings()" class="w-full gold-gradient-bg py-2.5 rounded-lg font-bold text-xs shadow-lg shadow-amber-500/10">
                        সেটিংস সেভ করুন
                    </button>
                </div>
            </section>

        </main>
    </div>

    <script>
        // --- Firebase Config ---
        const firebaseConfig = {
            apiKey: "AIzaSyCdCFqtmOdLp5zVAdjOow9Qq_7Lt7Z7wh0",
            authDomain: "app1-fbd12.firebaseapp.com",
            databaseURL: "https://app1-fbd12-default-rtdb.firebaseio.com",
            projectId: "app1-fbd12",
            storageBucket: "app1-fbd12.firebasestorage.app",
            messagingSenderId: "5576314669",
            appId: "1:5576314669:web:53cb24fab2af2694108da4"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.database();

        let currentAdminPass = "admin123";

        function verifyAdminPass() {
            const passInput = document.getElementById('adminPassInput').value.trim();

            db.ref('settings/adminPass').once('value', snap => {
                const activePass = snap.exists() ? snap.val() : currentAdminPass;

                if (passInput === activePass) {
                    document.getElementById('adminAuthCard').classList.add('hidden');
                    document.getElementById('adminMainContent').classList.remove('hidden');
                    initRealtimeAdmin();
                } else {
                    alert('ভুল এডমিন পাসওয়ার্ড দিয়েছেন!');
                }
            });
        }

        function switchTab(tab) {
            ['users', 'dep', 'wd', 'txlog', 'plans', 'gift', 'settings'].forEach(t => {
                document.getElementById('section' + t.charAt(0).toUpperCase() + t.slice(1)).classList.toggle('hidden', t !== tab);
                const btn = document.getElementById('tab-' + t);
                btn.className = (t === tab) ? "px-4 py-2 text-xs font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-xl" : "px-4 py-2 text-xs font-bold text-slate-400 rounded-xl";
            });
        }

        function initRealtimeAdmin() {
            loadCounters();
            loadPendingDeposits();
            loadPendingWithdraws();
            loadTransactionLogs();
            loadAdminPlans();
            loadGiftCodes();
            loadCurrentSettings();
        }

        function loadCounters() {
            db.ref('users').on('value', snap => {
                let active = 0, refs = 0;
                snap.forEach(u => {
                    if (u.val().hasDeposited) active++;
                    if (u.val().referredBy) refs++;
                });
                document.getElementById('cntActiveUsers').innerText = active;
                document.getElementById('cntTotalRefs').innerText = refs;
            });

            db.ref('deposits').on('value', snap => {
                let total = 0;
                snap.forEach(d => { if (d.val().status === 'approved') total += d.val().amount; });
                document.getElementById('cntTotalDp').innerText = '৳' + total;
            });

            db.ref('withdraws').on('value', snap => {
                let total = 0;
                snap.forEach(w => { if (w.val().status === 'approved') total += w.val().amount; });
                document.getElementById('cntTotalWd').innerText = '৳' + total;
            });
        }

        // --- User Management ---
        function searchUser() {
            const phone = document.getElementById('userSearchInput').value.trim();
            if (!phone) return alert('ফোন নম্বর প্রদান করুন!');

            db.ref('users/' + phone).on('value', snap => {
                const box = document.getElementById('userSearchResult');
                if (!snap.exists()) {
                    box.classList.remove('hidden');
                    box.innerHTML = `<p class="text-xs text-red-400">ইউজার পাওয়া যায়নি!</p>`;
                    return;
                }

                const u = snap.val();
                box.classList.remove('hidden');
                box.innerHTML = `
                    <div class="flex justify-between items-center border-b border-slate-800 pb-2 text-xs">
                        <div>
                            <span class="font-bold text-amber-300 text-sm block">${u.phone}</span>
                            <span class="text-slate-400 text-[11px]">রেফার কোড: ${u.refCode} | আপলাইন: ${u.referredBy || 'কেউ নেই'}</span>
                        </div>
                        <span class="px-2 py-0.5 text-[10px] rounded font-bold ${u.isBlocked ? 'bg-red-500/20 text-red-400 border border-red-500/30' : 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'}">
                            ${u.isBlocked ? 'ব্লকড (Blocked)' : 'সক্রিয় (Active)'}
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
                        <div class="bg-slate-900 p-2.5 rounded-lg space-y-2">
                            <span class="text-slate-400 block">বর্তমান ব্যালেন্স: <strong class="text-amber-400 font-bold text-sm">৳${(u.balance || 0).toFixed(2)}</strong></span>
                            <div class="flex gap-2">
                                <input type="number" id="manualAmountInput" placeholder="টাকার পরিমাণ" class="w-full bg-slate-950 border border-slate-700 p-1.5 rounded text-xs outline-none">
                                <button onclick="updateUserBalance('${u.phone}', 'add')" class="bg-emerald-600 px-3 py-1 rounded text-[11px] font-bold shrink-0">+ যোগ</button>
                                <button onclick="updateUserBalance('${u.phone}', 'deduct')" class="bg-red-600 px-3 py-1 rounded text-[11px] font-bold shrink-0">- কর্তন</button>
                            </div>
                        </div>

                        <div class="bg-slate-900 p-2.5 rounded-lg flex items-center justify-between">
                            <div>
                                <span class="font-bold text-slate-200 block">অ্যাকাউন্ট স্ট্যাটাস কন্ট্রোল</span>
                                <span class="text-[10px] text-slate-400">প্রতারণা বা ফেক ডিপোজিট বন্ধ করতে ব্লক করুন</span>
                            </div>
                            <button onclick="toggleUserBlock('${u.phone}', ${!u.isBlocked})" class="px-3 py-1.5 rounded text-xs font-bold ${u.isBlocked ? 'bg-emerald-600 text-white' : 'bg-rose-600 text-white'}">
                                ${u.isBlocked ? 'আনব্লক করুন' : 'ব্লক করুন'}
                            </button>
                        </div>
                    </div>
                `;
            });
        }

        function updateUserBalance(phone, action) {
            const amt = parseFloat(document.getElementById('manualAmountInput').value);
            if (isNaN(amt) || amt <= 0) return alert('সঠিক টাকার পরিমাণ লিখুন!');

            db.ref('users/' + phone).once('value', snap => {
                if (snap.exists()) {
                    const currentBal = snap.val().balance || 0;
                    const newBal = action === 'add' ? (currentBal + amt) : (currentBal - amt);

                    db.ref('users/' + phone).update({ balance: newBal }).then(() => {
                        db.ref('transactions').push({
                            user: phone,
                            type: action === 'add' ? 'admin_add' : 'admin_deduct',
                            amount: amt,
                            details: 'অ্যাডমিন ম্যানুয়াল আপডেট',
                            status: 'approved',
                            timestamp: firebase.database.ServerValue.TIMESTAMP
                        });
                        alert('ইউজার ব্যালেন্স আপডেট করা হয়েছে!');
                    });
                }
            });
        }

        function toggleUserBlock(phone, blockStatus) {
            db.ref('users/' + phone).update({ isBlocked: blockStatus }).then(() => {
                alert(blockStatus ? 'ইউজারকে ব্লক করা হয়েছে!' : 'ইউজারকে আনব্লক করা হয়েছে!');
            });
        }

        // --- Transaction Logs ---
        function loadTransactionLogs() {
            db.ref('transactions').limitToLast(50).on('value', snap => {
                const tbody = document.getElementById('txLogTableBody');
                if (!snap.exists()) {
                    tbody.innerHTML = `<tr><td colspan="5" class="p-3 text-center text-slate-500">কোনো হিস্ট্রি লগ পাওয়া যায়নি।</td></tr>`;
                    return;
                }

                let html = '';
                snap.forEach(c => {
                    const tx = c.val();
                    html = `
                        <tr class="hover:bg-slate-900/50">
                            <td class="p-2.5 font-bold text-amber-300">${tx.user}</td>
                            <td class="p-2.5 uppercase text-[10px]">${tx.type}</td>
                            <td class="p-2.5 font-bold text-emerald-400">৳${tx.amount}</td>
                            <td class="p-2.5 text-slate-400">${tx.details || 'N/A'}</td>
                            <td class="p-2.5 font-bold ${tx.status === 'approved' ? 'text-emerald-400' : (tx.status === 'rejected' ? 'text-rose-400' : 'text-amber-400')}">${tx.status ? tx.status.toUpperCase() : 'SUCCESS'}</td>
                        </tr>` + html;
                });
                tbody.innerHTML = html;
            });
        }

        // --- Deposits & Withdrawals ---
        function loadPendingDeposits() {
            db.ref('deposits').orderByChild('status').equalTo('pending').on('value', snap => {
                const box = document.getElementById('depListContainer');
                if (!snap.exists()) return box.innerHTML = '<p class="text-xs text-slate-500 text-center py-4">কোনো পেন্ডিং ডিপোজিট নেই।</p>';
                
                let html = '';
                snap.forEach(c => {
                    const dep = c.val();
                    html += `
                        <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex flex-wrap justify-between items-center gap-2 text-xs">
                            <div>
                                <span class="font-bold text-amber-300 block text-sm">${dep.user} (${dep.gateway})</span>
                                <span class="text-slate-400">প্রেরক: ${dep.sender} | TrxID: <strong class="text-slate-200 font-mono">${dep.trx}</strong></span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-base font-extrabold text-emerald-400">৳${dep.amount}</span>
                                <button onclick="approveDeposit('${c.key}', '${dep.user}', ${dep.amount}, '${dep.sender}')" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-lg font-bold">Approve</button>
                                <button onclick="rejectDeposit('${c.key}', '${dep.user}', ${dep.amount}, '${dep.sender}')" class="bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg font-bold">Reject</button>
                            </div>
                        </div>`;
                });
                box.innerHTML = html;
            });
        }

        function approveDeposit(key, userPhone, amount, sender) {
            db.ref('deposits/' + key).update({ status: 'approved' }).then(() => {
                db.ref('users/' + userPhone).once('value', snap => {
                    if (snap.exists()) {
                        const user = snap.val();
                        const isFirstDeposit = !user.hasDeposited;

                        db.ref('users/' + userPhone).update({
                            balance: (user.balance || 0) + amount,
                            hasDeposited: true
                        });

                        updateUserTransactionStatus(userPhone, 'deposit', amount, 'approved');

                        if (isFirstDeposit && user.referredBy) {
                            distribute3TierCommission(userPhone, amount);
                        }
                    }
                });
            });
        }

        function rejectDeposit(key, userPhone, amount, sender) { 
            db.ref('deposits/' + key).update({ status: 'rejected' }).then(() => {
                updateUserTransactionStatus(userPhone, 'deposit', amount, 'rejected');
            }); 
        }

        function loadPendingWithdraws() {
            db.ref('withdraws').orderByChild('status').equalTo('pending').on('value', snap => {
                const box = document.getElementById('wdListContainer');
                if (!snap.exists()) return box.innerHTML = '<p class="text-xs text-slate-500 text-center py-4">কোনো পেন্ডিং উইথড্র নেই।</p>';

                let html = '';
                snap.forEach(c => {
                    const wd = c.val();
                    html += `
                        <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex flex-wrap justify-between items-center gap-2 text-xs">
                            <div>
                                <span class="font-bold text-amber-300 block text-sm">${wd.user} (${wd.gateway})</span>
                                <span class="text-slate-400">টাকা পাওয়ার নম্বর: <strong class="text-slate-200 font-mono">${wd.number}</strong></span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-base font-extrabold text-rose-400">৳${wd.amount}</span>
                                <button onclick="approveWithdraw('${c.key}', '${wd.user}', ${wd.amount})" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-lg font-bold">Approve</button>
                                <button onclick="rejectWithdraw('${c.key}', '${wd.user}', ${wd.amount})" class="bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg font-bold">Reject & Refund</button>
                            </div>
                        </div>`;
                });
                box.innerHTML = html;
            });
        }

        function approveWithdraw(key, userPhone, amount) {
            db.ref('withdraws/' + key).update({ status: 'approved' }).then(() => {
                updateUserTransactionStatus(userPhone, 'withdraw', amount, 'approved');
            });
        }

        function rejectWithdraw(key, userPhone, amount) {
            db.ref('withdraws/' + key).update({ status: 'rejected' }).then(() => {
                db.ref('users/' + userPhone).once('value', snap => {
                    if (snap.exists()) {
                        db.ref('users/' + userPhone).update({ balance: (snap.val().balance || 0) + amount });
                    }
                });
                updateUserTransactionStatus(userPhone, 'withdraw', amount, 'rejected');
            });
        }

        function updateUserTransactionStatus(userPhone, type, amount, status) {
            db.ref('transactions').orderByChild('user').equalTo(userPhone).once('value', snap => {
                if (snap.exists()) {
                    snap.forEach(child => {
                        const tx = child.val();
                        if (tx.type === type && tx.amount === amount && tx.status === 'pending') {
                            db.ref('transactions/' + child.key).update({ status: status });
                        }
                    });
                }
            });
        }

        function distribute3TierCommission(userPhone, depositAmount) {
            db.ref('users/' + userPhone).once('value', snap1 => {
                if (!snap1.exists()) return;
                const ref1Code = snap1.val().referredBy;
                if (!ref1Code) return;

                findUserByRefCode(ref1Code, gen1User => {
                    if (gen1User) {
                        addCommission(gen1User.phone, depositAmount * 0.10, '1st Gen Referral Bonus');
                        if (gen1User.referredBy) {
                            findUserByRefCode(gen1User.referredBy, gen2User => {
                                if (gen2User) {
                                    addCommission(gen2User.phone, depositAmount * 0.05, '2nd Gen Referral Bonus');
                                    if (gen2User.referredBy) {
                                        findUserByRefCode(gen2User.referredBy, gen3User => {
                                            if (gen3User) addCommission(gen3User.phone, depositAmount * 0.025, '3rd Gen Referral Bonus');
                                        });
                                    }
                                }
                            });
                        }
                    }
                });
            });
        }

        function findUserByRefCode(code, callback) {
            db.ref('users').orderByChild('refCode').equalTo(code).once('value', snap => {
                if (snap.exists()) {
                    const k = Object.keys(snap.val())[0];
                    callback(snap.val()[k]);
                } else callback(null);
            });
        }

        function addCommission(phone, amount, desc) {
            db.ref('users/' + phone).once('value', snap => {
                if (snap.exists()) {
                    db.ref('users/' + phone).update({ balance: (snap.val().balance || 0) + amount });
                    db.ref('transactions').push({
                        user: phone, type: 'referral_commission', amount, details: desc, status: 'approved', timestamp: firebase.database.ServerValue.TIMESTAMP
                    });
                }
            });
        }

        // --- Investment Plans Management ---
        function savePlan() {
            const editKey = document.getElementById('planEditKey').value;
            const name = document.getElementById('planName').value.trim();
            const price = parseFloat(document.getElementById('planPrice').value);
            const daily = parseFloat(document.getElementById('planDaily').value);
            const validity = parseInt(document.getElementById('planValidity').value);
            const urlImg = document.getElementById('planImgUrl').value.trim();
            const fileInput = document.getElementById('planImageFile');

            if (!name || isNaN(price) || isNaN(daily) || isNaN(validity)) {
                return alert('দয়া করে প্যাকেজের নাম, মূল্য, দৈনিক লাভ এবং মেয়াদ সঠিকভাবে পূরণ করুন!');
            }

            const totalReturn = daily * validity;

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const base64Img = e.target.result;
                    pushOrUpdatePlan(editKey, { name, price, daily, validity, totalReturn, img: base64Img });
                };
                reader.readAsDataURL(fileInput.files[0]);
            } else {
                const defaultImg = urlImg || 'https://images.unsplash.com/photo-1618042164219-62c820f10723?auto=format&fit=crop&w=500&q=80';
                pushOrUpdatePlan(editKey, { name, price, daily, validity, totalReturn, img: defaultImg });
            }
        }

        function pushOrUpdatePlan(key, planData) {
            if (key) {
                db.ref('packages/' + key).update(planData).then(() => {
                    alert('প্যাকেজ সফলভাবে আপডেট করা হয়েছে!');
                    resetPlanForm();
                });
            } else {
                db.ref('packages').push(planData).then(() => {
                    alert('নতুন প্যাকেজ সফলভাবে যোগ করা হয়েছে!');
                    resetPlanForm();
                });
            }
        }

        function loadAdminPlans() {
            const defaultPackages = {
                p1: { name: "Green Energy Share", price: 500, daily: 40, validity: 30, totalReturn: 1200, img: "https://images.unsplash.com/photo-1466611653911-95081537e5b7?w=300" },
                p2: { name: "Tech Park Venture", price: 1500, daily: 130, validity: 30, totalReturn: 3900, img: "https://images.unsplash.com/photo-1518770660439-4636190af475?w=300" },
                p3: { name: "Mining Pool Alpha", price: 3500, daily: 320, validity: 35, totalReturn: 11200, img: "https://images.unsplash.com/photo-1621416894569-0f39ed31d247?w=300" },
                p4: { name: "Luxury Real Estate", price: 8000, daily: 800, validity: 40, totalReturn: 32000, img: "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?w=300" },
                p5: { name: "Global Gold Fund", price: 5000, daily: 480, validity: 35, totalReturn: 16800, img: "https://images.unsplash.com/photo-1610375461246-83df859d849d?w=300" },
                p6: { name: "AI Tech Hub", price: 10000, daily: 1050, validity: 45, totalReturn: 47250, img: "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=300" },
                p7: { name: "Crypto Reserve Prime", price: 15000, daily: 1650, validity: 50, totalReturn: 82500, img: "https://images.unsplash.com/photo-1622979135225-d2ba269bc1df?w=300" },
                p8: { name: "Luxury Aviation Share", price: 25000, daily: 2900, validity: 60, totalReturn: 174000, img: "https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=300" },
                p9: { name: "Ocean Logistics Pro", price: 35000, daily: 4200, validity: 60, totalReturn: 252000, img: "https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?w=300" },
                p10: { name: "Imperial Diamond Trust", price: 50000, daily: 6200, validity: 75, totalReturn: 465000, img: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?w=300" }
            };

            db.ref('packages').on('value', snap => {
                const box = document.getElementById('plansListContainer');
                
                if (!snap.exists()) {
                    db.ref('packages').set(defaultPackages);
                    return;
                }

                let html = '';
                snap.forEach(c => {
                    const p = c.val();
                    const totRet = p.totalReturn || (p.daily * p.validity);
                    html += `
                        <div class="bg-slate-900 border border-slate-800 p-3 rounded-xl flex items-center gap-3 text-xs">
                            <img src="${p.img}" class="w-14 h-14 rounded-lg object-cover border border-amber-500/30 shrink-0">
                            <div class="flex-1 space-y-0.5">
                                <h5 class="font-bold text-amber-300 text-xs">${p.name}</h5>
                                <div class="text-slate-300 text-[11px]">মূল্য: ৳${p.price} | দৈনিক: ৳${p.daily}</div>
                                <div class="text-slate-400 text-[10px]">মেয়াদ: ${p.validity} দিন | মোট রিটার্ন: <strong class="text-emerald-400">৳${totRet}</strong></div>
                            </div>
                            <div class="flex flex-col gap-1.5 shrink-0">
                                <button onclick="editPlan('${c.key}', '${p.name}', ${p.price}, ${p.daily}, ${p.validity}, '${p.img}')" class="bg-amber-500/20 text-amber-300 px-2.5 py-1 rounded text-[10px] font-bold">এডিট</button>
                                <button onclick="deletePlan('${c.key}')" class="bg-red-500/20 text-red-400 px-2.5 py-1 rounded text-[10px] font-bold">ডিলিট</button>
                            </div>
                        </div>`;
                });
                box.innerHTML = html;
            });
        }

        function editPlan(key, name, price, daily, validity, img) {
            document.getElementById('planEditKey').value = key;
            document.getElementById('planName').value = name;
            document.getElementById('planPrice').value = price;
            document.getElementById('planDaily').value = daily;
            document.getElementById('planValidity').value = validity;
            document.getElementById('planImgUrl').value = img.startsWith('data:') ? '' : img;

            document.getElementById('planFormTitle').innerText = 'প্যাকেজ এডিট করুন';
            document.getElementById('planSubmitBtn').innerText = 'আপডেট করুন';
            document.getElementById('planCancelBtn').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function resetPlanForm() {
            document.getElementById('planEditKey').value = '';
            document.getElementById('planName').value = '';
            document.getElementById('planPrice').value = '';
            document.getElementById('planDaily').value = '';
            document.getElementById('planValidity').value = '';
            document.getElementById('planImgUrl').value = '';
            document.getElementById('planImageFile').value = '';

            document.getElementById('planFormTitle').innerText = 'নতুন ইনভেস্টমেন্ট প্যাকেজ যোগ করুন';
            document.getElementById('planSubmitBtn').innerText = 'প্যাকেজ সেভ করুন';
            document.getElementById('planCancelBtn').classList.add('hidden');
        }

        function deletePlan(key) {
            if (confirm('আপনি কি নিশ্চিত এই প্যাকেজটি ডিলিট করতে চান?')) {
                db.ref('packages/' + key).remove().then(() => alert('প্যাকেজ ডিলিট করা হয়েছে!'));
            }
        }

        // --- Gift Codes & Settings ---
        function createGiftCode() {
            const code = document.getElementById('giftCodeInput').value.trim().toUpperCase();
            const amount = parseFloat(document.getElementById('giftAmountInput').value);

            if (!code || !amount) return alert('কোড ও টাকা সঠিক দিন!');

            db.ref('gift_codes/' + code).set({ amount, createdAt: firebase.database.ServerValue.TIMESTAMP }).then(() => {
                alert('গিফট কোড পাবলিশ হয়েছে!');
                document.getElementById('giftCodeInput').value = '';
                document.getElementById('giftAmountInput').value = '';
            });
        }

        function loadGiftCodes() {
            db.ref('gift_codes').on('value', snap => {
                const box = document.getElementById('giftListContainer');
                if (!snap.exists()) return box.innerHTML = '<p class="text-xs text-slate-500">কোনো গিফট কোড নেই।</p>';

                let html = '';
                snap.forEach(c => {
                    html += `
                        <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-lg flex justify-between items-center text-xs">
                            <span class="font-mono text-amber-300 font-bold">${c.key} (৳${c.val().amount})</span>
                            <button onclick="deleteGiftCode('${c.key}')" class="text-red-400 hover:underline">ডিলিট</button>
                        </div>`;
                });
                box.innerHTML = html;
            });
        }

        function deleteGiftCode(code) { db.ref('gift_codes/' + code).remove(); }

        function changeAdminPassword() {
            const newPass = document.getElementById('newAdminPassInput').value.trim();
            if (!newPass) return alert('নতুন পাসওয়ার্ড লিখুন!');

            db.ref('settings/adminPass').set(newPass).then(() => {
                alert('এডমিন পাসওয়ার্ড পরিবর্তন করা হয়েছে! পরবর্তী লগইনে এই পাসওয়ার্ড ব্যবহার করুন।');
                document.getElementById('newAdminPassInput').value = '';
            });
        }

        function loadCurrentSettings() {
            db.ref('settings').once('value', snap => {
                if (snap.exists()) {
                    if (snap.val().bkashNum) document.getElementById('settingBkashNum').value = snap.val().bkashNum;
                    if (snap.val().nagadNum) document.getElementById('settingNagadNum').value = snap.val().nagadNum;
                    if (snap.val().telegramLink) document.getElementById('settingTelegramLink').value = snap.val().telegramLink;
                    if (snap.val().whatsappLink) document.getElementById('settingWhatsappLink').value = snap.val().whatsappLink;
                    if (snap.val().notice) document.getElementById('settingNotice').value = snap.val().notice;
                }
            });
        }

        function saveSettings() {
            const bkashNum = document.getElementById('settingBkashNum').value.trim();
            const nagadNum = document.getElementById('settingNagadNum').value.trim();
            const telegramLink = document.getElementById('settingTelegramLink').value.trim();
            const whatsappLink = document.getElementById('settingWhatsappLink').value.trim();
            const notice = document.getElementById('settingNotice').value.trim();

            db.ref('settings').update({ bkashNum, nagadNum, telegramLink, whatsappLink, notice }, err => {
                if (!err) alert('সেটিংস সফলভাবে সেভ করা হয়েছে!');
            });
        }
    </script>
</body>
</html>
